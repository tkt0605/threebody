# ThreeBody の環境変数テンプレート
#
# 使い方: `cp .env.example .env` してから値を埋める。
# フロントエンド（Vite）とバックエンド（Express）が同じ1ファイルを共有している。
#
# 【重要】.env は同じキーを2回書くと後の行が勝つ。実際にこれで
# ANTHROPIC_MODEL_BALANCED が空文字に上書きされ、レベル3〜5でモデル名が
# 空のままAPIへ渡る状態になっていたことがある。キーは1回だけ書くこと。


# ============================================================================
# フロントエンド（VITE_ プレフィックスが付いたものだけがブラウザへ露出する）
# ============================================================================

# バックエンドのURL。未設定なら http://localhost:3000 が使われる
VITE_API_BASE_URL=http://localhost:3000

# 【注意】名前に反してバックエンドが読む値。backend/index.ts が CORS の
# origin として使う（＝フロントエンドが動いているURLを書く）。
# VITE_ プレフィックスは歴史的経緯によるもので、ブラウザ側では使っていない
VITE_ORIGIN_BASE_URL=http://localhost:5174

# フロント用 Supabase クライアント（src/lib/supabase.ts）。
# anon key は公開前提の値で、RLS で守る設計になっている
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ============================================================================
# Supabase（バックエンド用・service_role）
# ============================================================================

# service key は RLS も列GRANTも両方バイパスする。絶対にフロントへ渡さないこと。
# 未設定でもサーバーは起動するが、共有キー機能が丸ごと無効になる
SUPABASE_URL=
SUPABASE_SERVICE_KEY=


# ============================================================================
# 共有APIキー（運営が負担する無料お試し枠）
# ============================================================================

# 未設定なら共有キー機能は無効（reason: 'unavailable'）になり、
# ユーザーは自分のキーを登録しない限り会話できない。
# 1ユーザーあたり1日3回・全ユーザー合計1日50回の上限は backend/sharedKey.ts 側の定数
SHARED_ANTHROPIC_API_KEY=

# 単体モードで provider=anthropic を使う場合の運営側キー。
# 通常は空でよい（ユーザーが自分のキーを設定して使うため）
ANTHROPIC_API_KEY=


# ============================================================================
# モデル指定 — ここを書き換えるだけでモデルを差し替えられる
#
# 【未設定に注意】backend/llm/modelConfig.ts は process.env.X! と非null断言で
# 読んでいるため、書き忘れても型エラーにならず undefined のままAPIへ渡る。
# 使うプロバイダーのぶんは必ず埋めること
# ============================================================================

ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
ANTHROPIC_MODEL_POWERFUL=claude-opus-5

OPENAI_MODEL_FAST=
OPENAI_MODEL_BALANCED=
OPENAI_MODEL_POWERFUL=

DEEPSEEK_MODEL_FAST=
DEEPSEEK_MODEL_POWERFUL=


# ============================================================================
# Ollama（ローカルLLM）
# ============================================================================

# デプロイ先でOllamaに到達できるかの宣言。未設定は true 扱い。
# 到達できない環境（Render等）では false にしないと、UIが「使える」と表示して
# 送信して初めて接続エラーになる
OLLAMA_ENABLED=false

OLLAMA_BASE_URL=http://localhost:11434

# キー無し・設定無しでも動く既定モデル。事前に `ollama pull` 済みのモデル名にする
OLLAMA_MODEL_DEFAULT=

# 三体モードは副体を並列で呼ぶため、1では順番待ちになる
OLLAMA_NUM_PARALLEL=2
OLLAMA_FLASH_ATTENTION=1


# ============================================================================
# サーバー
# ============================================================================

# 未設定なら 3000。Render等のPaaSは自動で注入するので、本番では設定しない
PORT=3000

# 副体のWeb検索（共有キー経路では常に無効）。空なら既存の検算のみ。
# SearXNG: https://your-searxng.example/search （JSON形式を有効にする）
# Brave: https://api.search.brave.com/res/v1/web/search
# BraveのキーはX-Subscription-Token、その他はBearer認証として送る。
SEARCH_API_URL=
SEARCH_API_KEY=

{
  "name": "threebody (Node.js & TypeScript)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "node",

  // Vite dev server (5174) + Express API server (3000)
  "forwardPorts": [
    5174,
    3000
  ],

  // .env はコード側 (dotenv) で読み込むため runArgs での受け渡しは不要
  // .env.example の有無に関係なく開けるよう、未作成なら空ファイルを生成する

  // 初回作成時: .env がなければ空ファイルを生成し、
  // 既存の node_modules を消してから入れ直す
  "postCreateCommand": "[ -f .env ] || touch .env; rm -rf node_modules && npm install",

  
  // コンテナ起動のたびに Ollama を並列推論モードで起動
  "postStartCommand": "echo 'Using host Ollama via host.docker.internal' ",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "christian-kohler.npm-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

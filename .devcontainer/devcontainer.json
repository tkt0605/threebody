{
  "name": "threebody (Node.js & TypeScript)",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "node",

  // Vite dev server (5173) + Express API server (3000)
  "forwardPorts": [
    5173,
    3000
  ],

  // .env はコード側 (dotenv) で読み込むため runArgs での受け渡しは不要
  // .env が未作成の場合に備え、postCreateCommand でテンプレートから生成する

  // 初回作成時: .env がなければ .env.example からコピー（なければ空ファイル生成）し、
  // 既存の node_modules を消してから入れ直す
  "postCreateCommand": "[ -f .env ] || { [ -f .env.example ] && cp .env.example .env || touch .env; }; rm -rf node_modules && npm install",

  // コンテナ起動のたびに Ollama を並列推論モードで起動
  "postStartCommand": "pkill -f 'ollama serve' 2>/dev/null; sleep 1 && OLLAMA_NUM_PARALLEL=2 ollama serve > /tmp/ollama.log 2>&1 &",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "christian-kohler.npm-intellisense"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
